# Copy this file to .env and fill in your own values.
PORT=3000
MONGODB_URI=
JWT_SECRET=
BASE_URL=http://localhost:3000

# For Gmail SMTP use a Google App Password (16 chars), not your normal Gmail password.
# Enable 2-Step Verification on your Google account, then create an App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# If you use a different SMTP provider, set the values above accordingly.
# Example for Mailtrap:
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_SECURE=false
