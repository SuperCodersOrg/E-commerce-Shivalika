<%- include("../partials/header", { pageTitle: "Forgot Password" }) %>

<main class="auth-container">
    <form class="auth-card" action="/auth/forgot-password" method="POST">
        <h1>Forgot Password</h1>
        <p>Enter your registered email to request a reset link.</p>

        <% if (message) { %>
            <p class="success"><%= message %></p>
        <% } %>

        <label for="email">Email</label>
        <input id="email" type="email" name="email" required
               autocomplete="email">

        <button type="submit" class="primary-btn">Send Reset Link</button>
        <p><a href="/auth/login">Back to login</a></p>
    </form>
</main>

<%- include("../partials/footer") %>