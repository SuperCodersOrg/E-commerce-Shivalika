<%- include("../partials/header", { pageTitle: "Forgot Password" }) %>

<main class="auth-container">
    <form class="auth-card" action="/auth/forgot-password" method="POST">
        <h1>Forgot Password</h1>
        <p class="muted">Enter your registered email to request a reset link.</p>

        <% if (message) { %>
            <p class="success"><%= message %></p>
        <% } %>

        <% if (typeof resetLink !== "undefined" && resetLink) { %>
            <div class="verification-notice">
                <p><strong>Password Reset Link Ready:</strong></p>
                <p class="small-text">Since the email service is offline, use this direct link:</p>
                <a href="<%= resetLink %>" class="primary-btn button-link verify-btn">Reset Password Now</a>
            </div>
        <% } %>

        <label for="email">Email</label>
        <input id="email" type="email" name="email" required
               autocomplete="email" placeholder="john@example.com">

        <button type="submit" class="primary-btn">Send Reset Link</button>
        <p><a href="/auth/login">Back to login</a></p>
    </form>
</main>

<%- include("../partials/footer") %>