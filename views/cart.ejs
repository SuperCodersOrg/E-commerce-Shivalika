<%- include("partials/header", { pageTitle: "My Shopping Cart" }) %>
<%- include("partials/navbar") %>

<main class="cart-container">
    <div class="cart-header">
        <h1>Shopping Cart</h1>
        <a href="/dashboard" class="back-link">&larr; Continue Shopping</a>
    </div>

    <% if (!cartItems || cartItems.length === 0) { %>
        <div class="empty-cart-card">
            <div class="empty-cart-icon">🛒</div>
            <h2>Your cart is currently empty</h2>
            <p class="muted">Looks like you haven't added any products to your cart yet.</p>
            <a href="/dashboard" class="primary-btn button-link">Discover Products</a>
        </div>
    <% } else { %>
        <div class="cart-layout">
            <!-- Cart Items List -->
            <section class="cart-items-section">
                <% cartItems.forEach(item => { %>
                    <div class="cart-item-card" id="item-<%= item.product._id %>">
                        <div class="cart-item-image">
                            <img
                                src="<%= item.product.thumbnail || '/images/placeholder.svg' %>"
                                alt="<%= item.product.title %>"
                                onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                            >
                        </div>

                        <div class="cart-item-details">
                            <span class="product-category"><%= item.product.category || "Product" %></span>
                            <h3 class="cart-item-title"><%= item.product.title %></h3>
                            <p class="cart-item-price">$<%= Number(item.price || item.product.price || 0).toFixed(2) %></p>

                            <div class="cart-item-meta-actions">
                                <a href="/products/<%= item.product._id %>" class="show-details-btn">
                                    <span>🔍</span> Show Details
                                </a>
                                <button type="button" class="remove-item-btn" onclick="removeItem('<%= item.product._id %>')">
                                    <span>🗑️</span> Remove
                                </button>
                            </div>
                        </div>

                        <div class="cart-item-quantity-column">
                            <div class="qty-control cart-qty-control">
                                <button type="button" class="qty-btn" onclick="updateQuantity('<%= item.product._id %>', 'decrease')">-</button>
                                <span class="qty-display" id="qty-<%= item.product._id %>"><%= item.quantity %></span>
                                <button type="button" class="qty-btn" onclick="updateQuantity('<%= item.product._id %>', 'increase')">+</button>
                            </div>

                            <p class="cart-item-subtotal">
                                Total: <strong id="item-total-<%= item.product._id %>">$<%= Number((item.price || item.product.price || 0) * item.quantity).toFixed(2) %></strong>
                            </p>
                        </div>
                    </div>
                <% }); %>
            </section>

            <!-- Bill Summary & Place Order Card -->
            <aside class="cart-summary-section">
                <div class="summary-card">
                    <h2>Order Bill Summary</h2>

                    <div class="summary-line">
                        <span>Items Subtotal:</span>
                        <strong id="billSubtotal">$<%= totals.subtotal.toFixed(2) %></strong>
                    </div>

                    <div class="summary-line">
                        <span>Estimated Shipping:</span>
                        <strong id="billShipping"><%= totals.shippingFee === 0 ? "FREE" : "$" + totals.shippingFee.toFixed(2) %></strong>
                    </div>

                    <div class="summary-line">
                        <span>Estimated Tax (5%):</span>
                        <strong id="billTax">$<%= totals.tax.toFixed(2) %></strong>
                    </div>

                    <hr class="summary-divider">

                    <div class="summary-total-line">
                        <span>Total Amount:</span>
                        <strong id="billTotal" class="total-price">$<%= totals.totalAmount.toFixed(2) %></strong>
                    </div>

                    <div class="cart-summary-actions">
                        <a href="/checkout" class="primary-btn place-order-btn">
                            Place Order &rarr;
                        </a>
                    </div>

                    <p class="secure-checkout-text">
                        <span>🔒</span> Secure Stripe checkout with address confirmation
                    </p>
                </div>
            </aside>
        </div>
    <% } %>
</main>

<script>
    async function updateQuantity(productId, action) {
        try {
            const res = await fetch("/api/cart/update", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify({ productId, action })
            });

            if (!res.ok) throw new Error("Could not update quantity.");

            // Reload page to reflect updated bill and cart state
            window.location.reload();
        } catch (err) {
            alert(err.message);
        }
    }

    async function removeItem(productId) {
        if (!confirm("Are you sure you want to remove this item from your cart?")) return;

        try {
            const res = await fetch("/api/cart/remove", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify({ productId })
            });

            if (!res.ok) throw new Error("Could not remove item.");

            window.location.reload();
        } catch (err) {
            alert(err.message);
        }
    }
</script>

<%- include("partials/footer") %>
