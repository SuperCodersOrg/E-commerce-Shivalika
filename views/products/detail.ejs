<%- include("../partials/header", { pageTitle: product.title }) %>
<%- include("../partials/navbar") %>

<main class="detail-container">
    <div class="detail-image-section">
        <div class="detail-image">
            <img
                id="mainImage"
                src="<%= product.thumbnail || (product.images && product.images.length > 0 ? product.images[0] : '/images/placeholder.svg') %>"
                alt="<%= product.title %>"
                onerror="this.onerror=null;this.src='/images/placeholder.svg';"
            >
        </div>

        <% if (product.images && product.images.length > 1) { %>
            <div class="detail-thumbnails">
                <% product.images.forEach((imgUrl, idx) => { %>
                    <img
                        src="<%= imgUrl %>"
                        alt="Thumbnail <%= idx + 1 %>"
                        class="thumbnail-item <%= idx === 0 ? 'active' : '' %>"
                        onclick="document.getElementById('mainImage').src = this.src; document.querySelectorAll('.thumbnail-item').forEach(el => el.classList.remove('active')); this.classList.add('active');"
                        onerror="this.style.display='none';"
                    >
                <% }); %>
            </div>
        <% } %>
    </div>

    <section class="detail-info">
        <a href="/dashboard" class="back-link">&larr; Back to Products</a>
        <p class="category-label"><%= product.category || "Product" %></p>

        <h1><%= product.title %></h1>

        <% if (product.brand) { %>
            <p class="brand-text"><strong>Brand:</strong> <%= product.brand %></p>
        <% } %>

        <p class="price">
            $<%= Number(product.price || 0).toFixed(2) %>
        </p>

        <div class="detail-actions">
            <div class="quantity-picker">
                <label for="detailQuantity">Quantity:</label>
                <div class="qty-control">
                    <button type="button" class="qty-btn" onclick="let q=document.getElementById('detailQuantity'); if(q.value>1) q.value--;">-</button>
                    <input type="number" id="detailQuantity" value="1" min="1" max="99">
                    <button type="button" class="qty-btn" onclick="let q=document.getElementById('detailQuantity'); q.value++;">+</button>
                </div>
            </div>

            <button type="button" id="detailAddToCartBtn" class="primary-btn detail-add-cart-btn">
                <span>🛒</span> Add to Cart
            </button>
            <a href="/cart" class="secondary-btn go-cart-btn">View Cart</a>
        </div>

        <h2>Description</h2>
        <p class="description-text"><%= product.description || "No description available." %></p>

        <% if (product.specifications &&
               typeof product.specifications === 'object' &&
               Object.keys(product.specifications).length > 0) { %>

            <h2>Specifications</h2>

            <ul class="spec-list">
                <% Object.entries(product.specifications).forEach(([key, value]) => { %>
                    <li>
                        <strong><%= key %>:</strong>
                        <%= typeof value === "object"
                            ? JSON.stringify(value)
                            : value %>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </section>
</main>

<!-- Login Required Modal Popup -->
<div id="loginModalOverlay" class="modal-overlay" hidden>
    <div class="modal-card" role="dialog" aria-modal="true">
        <button id="closeModalBtn" class="modal-close-btn">&times;</button>
        <div class="modal-icon">🛍️</div>
        <h2>Login Required</h2>
        <p class="modal-desc">
            Please log in or create an account to add items to your cart and place orders.
        </p>
        <div class="modal-actions">
            <a href="/auth/login?redirect=/products/<%= product._id %>" class="primary-btn modal-login-btn">Log In</a>
            <a href="/auth/signup" class="secondary-btn modal-signup-btn">Create an Account</a>
        </div>
        <button id="cancelModalBtn" class="modal-cancel-link">Continue Browsing as Guest</button>
    </div>
</div>

<!-- Floating Toast Notification -->
<div id="toastNotification" class="toast-notification" hidden></div>

<script>
    const IS_USER_LOGGED_IN = <%= typeof user !== "undefined" && user ? "true" : "false" %>;
    const PRODUCT_ID = "<%= product._id %>";
    const PRODUCT_TITLE = "<%= product.title.replace(/"/g, '\\"') %>";

    const detailAddToCartBtn = document.getElementById("detailAddToCartBtn");
    const loginModalOverlay = document.getElementById("loginModalOverlay");
    const closeModalBtn = document.getElementById("closeModalBtn");
    const cancelModalBtn = document.getElementById("cancelModalBtn");
    const toastNotification = document.getElementById("toastNotification");
    const cartBadge = document.getElementById("cartBadge");

    function showToast(message, isError = false) {
        if (!toastNotification) return;
        toastNotification.textContent = message;
        toastNotification.className = "toast-notification " + (isError ? "toast-error" : "toast-success");
        toastNotification.hidden = false;
        toastNotification.classList.add("toast-show");
        setTimeout(() => {
            toastNotification.classList.remove("toast-show");
            setTimeout(() => { toastNotification.hidden = true; }, 300);
        }, 3000);
    }

    function openModal() {
        if (loginModalOverlay) {
            loginModalOverlay.hidden = false;
            document.body.style.overflow = "hidden";
        }
    }

    function closeModal() {
        if (loginModalOverlay) {
            loginModalOverlay.hidden = true;
            document.body.style.overflow = "";
        }
    }

    if (closeModalBtn) closeModalBtn.addEventListener("click", closeModal);
    if (cancelModalBtn) cancelModalBtn.addEventListener("click", closeModal);
    if (loginModalOverlay) {
        loginModalOverlay.addEventListener("click", (e) => {
            if (e.target === loginModalOverlay) closeModal();
        });
    }

    detailAddToCartBtn.addEventListener("click", async () => {
        if (!IS_USER_LOGGED_IN) {
            openModal();
            return;
        }

        const qtyInput = document.getElementById("detailQuantity");
        const quantity = Math.max(1, parseInt(qtyInput ? qtyInput.value : 1, 10));

        try {
            detailAddToCartBtn.disabled = true;
            const res = await fetch("/api/cart/add", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify({ productId: PRODUCT_ID, quantity })
            });

            if (res.status === 401) {
                openModal();
                return;
            }

            const data = await res.json();
            if (!res.ok) throw new Error(data.error || "Failed to add to cart.");

            if (cartBadge && typeof data.cartCount !== "undefined") {
                cartBadge.textContent = data.cartCount;
                cartBadge.classList.add("badge-bounce");
                setTimeout(() => cartBadge.classList.remove("badge-bounce"), 400);
            }

            showToast(data.message || "Added to cart!");
        } catch (err) {
            showToast(err.message, true);
        } finally {
            detailAddToCartBtn.disabled = false;
        }
    });
</script>

<%- include("../partials/footer") %>